#!/usr/bin/env python3
"""Prepare a patch release for changes to the review command instructions."""

import json
import re
import subprocess
from pathlib import Path

plugin = Path("plugins/proofline/.claude-plugin/plugin.json")
catalog = Path(".claude-plugin/marketplace.json")
command = Path("plugins/proofline/commands/review.md")
released = subprocess.check_output(["git", "log", "-1", "--format=%H", "--", plugin], text=True).strip()
previous = subprocess.check_output(["git", "show", f"{released}:{command}"])
current = command.read_bytes()
if current == previous:
    raise SystemExit(0)
before, after = (data.split(b"---\n", 2) for data in (previous, current))
if len(before) != 3 or len(after) != 3 or before[:2] != after[:2]:
    raise SystemExit("Command metadata changed. Review the command declaration before releasing.")
number = json.loads(plugin.read_bytes())["version"]
if not re.fullmatch(r"(?:0|[1-9][0-9]*)(?:\.(?:0|[1-9][0-9]*)){2}", number):
    raise SystemExit("Expected a stable plugin version.")
major, minor, patch = map(int, number.split("."))
updated = f"{major}.{minor}.{patch + 1}"
for path in (plugin, catalog):
    text = path.read_text()
    old = f'"version": "{number}"'
    if text.count(old) != 1:
        raise SystemExit(f"{path} must contain the released version exactly once.")
    path.write_text(text.replace(old, f'"version": "{updated}"'))
print(f"Prepared plugin version {updated}.")
